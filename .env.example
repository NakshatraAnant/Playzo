# PLAYZO local configuration. Copy to .env and adjust. Never commit real secrets.
PLAYZO_API_PORT=5758
PLAYZO_WEB_PORT=5757
PLAYZO_PUBLIC_URL=http://localhost:5757
# Database file (SQLite via node:sqlite for local development)
PLAYZO_DB_PATH=data/playzo.db
# Local dev mode: enables the dev email outbox (/dev/outbox) and the NON-PRODUCTION
# age-assurance attestation (QA accounts only). Always refused when NODE_ENV=production.
PLAYZO_DEV_MODE=true

# ---- PLAYZO Lounge (18+) — keep OFF until written legal and platform clearance ----
# Master switch for public Lounge access. Default false.
PLAYZO_LOUNGE_ENABLED=false
# Per-game legal references, e.g. "eu-roulette:OPINION-2027-014". A game opens only when the master
# switch is on, it is listed here, AND Admin → Legal holds an "approved" record with the same reference.
PLAYZO_LEGAL_APPROVALS=
# Internal QA only: lets accounts with the admin or tester role open the Lounge on localhost with
# "DEV PREVIEW — NOT LEGALLY APPROVED" banners. Ignored in production. Default false.
PLAYZO_ADULT_DEV_PREVIEW=false
# Adult verification must be renewed after this many days.
PLAYZO_AGE_VERIFICATION_DAYS=365

# ---- Email delivery ----
# 'outbox' (default) stores messages locally and never sends them. 'resend' sends through the
# Resend API when both values below are set.
PLAYZO_EMAIL_PROVIDER=outbox
PLAYZO_EMAIL_FROM=
RESEND_API_KEY=

# OAuth (leave blank — Google/Apple sign-in stays disabled until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Bootstrap admin (created at API start if set). Use a long random password.
PLAYZO_ADMIN_EMAIL=admin@playzo.local
PLAYZO_ADMIN_PASSWORD=
# Automated tests only (multiplies rate limits). Ignored in production.
PLAYZO_RATE_LIMIT_MULTIPLIER=1
