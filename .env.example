# PLAYZO local configuration. Copy to .env and adjust. Never commit real secrets.
PLAYZO_API_PORT=5758
PLAYZO_WEB_PORT=5757
PLAYZO_PUBLIC_URL=http://localhost:5757
# Database file (SQLite via node:sqlite for local development)
PLAYZO_DB_PATH=data/playzo.db
# Local dev auth mode: enables the dev email outbox (/dev/outbox) and the
# NON-PRODUCTION age-assurance attestation provider. Refused when NODE_ENV=production.
PLAYZO_DEV_MODE=true
# Adult lounge legal gate. All adult modules remain DISABLED unless a game id is
# listed here together with a legal approval reference, e.g. "eu-roulette:LEGAL-REF-123".
PLAYZO_LEGAL_APPROVALS=
# Internal QA only: lets age-verified adult test accounts open adult modules on
# localhost with a "DEV PREVIEW — NOT LEGALLY APPROVED" banner. Refused in production.
PLAYZO_ADULT_DEV_PREVIEW=false
# OAuth (leave blank — Google/Apple sign-in stays disabled until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Bootstrap admin (created by `npm run seed` if set)
PLAYZO_ADMIN_EMAIL=admin@playzo.local
PLAYZO_ADMIN_PASSWORD=
