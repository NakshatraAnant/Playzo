{
  "name": "playzo",
  "version": "0.1.0",
  "private": true,
  "description": "PLAYZO — Aaja PLAYZO pe khelte hain! A mobile-first social gaming platform (local build).",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "node scripts/wait-api.mjs && vite",
    "build": "vite build && tsx scripts/prerender-seo.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "rtp": "tsx scripts/rtp-report.ts",
    "gdd": "tsx scripts/generate-gdds.ts",
    "seed": "tsx server/seed.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && vitest run && playwright test",
    "local": "npm run build && npm run serve:local",
    "serve:local": "cross-env PLAYZO_SERVE_DIST=true PLAYZO_API_PORT=5757 tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "an-array-of-english-words": "^2.0.0",
    "fastify": "^5.12.8",
    "framer-motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
